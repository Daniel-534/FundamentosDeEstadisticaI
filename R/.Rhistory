install.packages(c("ggplot2", "dplyr", "psych", "corrplot", "GGally"))
# Cargar librerías
library(ggplot2)
library(dplyr)
library(psych)
library(GGally)
install.packages("GGally")
# Cargar la base de datos iris
data(iris)
# Limpiar entorno
rm(list = ls())
# Opciones de impresión
options(digits = 4, scipen = 999)
# Cargar librerías
library(ggplot2)
library(dplyr)
library(psych)
library(GGally)
# Cargar la base de datos iris
data(iris)
cat("\n=========================================\n")
cat(" 1. EXPLORACIÓN INICIAL\n")
cat("=========================================\n")
# Dimensiones
cat("\nDimensiones (filas x columnas):\n"); print(dim(iris))
# Nombres de variables
cat("\nNombres de variables:\n"); print(names(iris))
# Estructura
cat("\nEstructura del data frame:\n"); str(iris)
# Primeras y últimas filas
cat("\nPrimeras 6 filas:\n"); print(head(iris))
cat("\nÚltimas 6 filas:\n");  print(tail(iris))
# Resumen general
cat("\nResumen general:\n"); print(summary(iris))
# Valores perdidos
cat("\nValores perdidos por variable:\n"); print(colSums(is.na(iris)))
cat("\n=========================================\n")
cat("=========================================\n")
# --- 2.1 Frecuencias para variable categórica: Species -------------------
cat("\n--- Frecuencias absolutas y relativas: Species ---\n")
tab_species <- as.data.frame(table(iris$Species))
colnames(tab_species) <- c("Species", "Frecuencia_Absoluta")
tab_species$Frecuencia_Relativa <- round(tab_species$Frecuencia_Absoluta / sum(tab_species$Frecuencia_Absoluta), 4)
tab_species$Porcentaje          <- round(100 * tab_species$Frecuencia_Relativa, 2)
tab_species$Frec_Acumulada      <- cumsum(tab_species$Frecuencia_Absoluta)
tab_species$Frec_Rel_Acumulada  <- cumsum(tab_species$Frecuencia_Relativa)
print(tab_species)
